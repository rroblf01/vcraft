# vcraft build artefacts
/build/
/dist/
/wheelhouse/
/target/

# generated by vcraft
**/_vcraft_generated.v
python/*/_stubs.pyi
!examples/**/_stubs.pyi
python/*/_stubs.pyi
!examples/**/_stubs.pyi
*.so
*.dylib
*.dll
*.pyd

# V compiler output
*.o
*.a
*.c
*.s

# Hand-written C lives in a c/ directory next to the module that owns it.
!**/c/*.c
!**/c/*.h

# V compiler scratch directories
.*.v3cc.*/
.*.vtmp*/

__pycache__/
*.py[cod]

# Python virtual environments
.venv/
venv/
env/

# packaging / tooling caches
.vcraft/
/.cache/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# OS noise
.DS_Store
Thumbs.db

# generated glue and stubs, rebuilt by `vcraft build`
